{
  "name": "ms2app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:doppler": "doppler run -- next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "migrate:uploads-to-s3": "node scripts/migrate-uploads-to-s3.mjs",
    "seed:positions": "node scripts/seed-positions.ts",
    "check:env": "node scripts/check-env.mjs",
    "check:env:strict": "node scripts/check-env.mjs --strict",
    "backup:db": "bash scripts/backup-db.sh",
    "prebuild": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/react": "^3.0.186",
    "@aws-sdk/client-s3": "^3.1048.0",
    "@prisma/client": "^5.22.0",
    "@sentry/nextjs": "^10.56.0",
    "@types/qrcode": "^1.5.6",
    "@upstash/qstash": "^2.11.1",
    "@vercel/analytics": "^2.0.1",
    "ai": "^6.0.184",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "libphonenumber-js": "^1.13.6",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "otplib": "^13.4.0",
    "papaparse": "^5.5.3",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
