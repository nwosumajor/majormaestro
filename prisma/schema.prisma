datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RecoveryComplaint {
  id                 String             @id @default(cuid())
  referenceId        String             @unique
  companyName        String
  rcNumber           String
  turnoverBand       String
  banks              String[]
  contactName        String
  contactTitle       String
  contactEmail       String
  contactPhone       String
  confirmedSignatory Boolean
  agreedNDPA         Boolean
  status             String             @default("received")
  assignedTeam       String?
  referralCode       String?
  referral           Referral?          @relation(fields: [referralCode], references: [code])
  documents          UploadedDocument[]
  statusEvents       CaseStatusEvent[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([referralCode])
}

model UploadedDocument {
  id           String            @id @default(cuid())
  complaintId  String
  complaint    RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  documentType String
  fileName     String
  storedAs     String
  fileSize     Int
  mimeType     String
  uploadedAt   DateTime          @default(now())
}

model CaseStatusEvent {
  id          String            @id @default(cuid())
  complaintId String
  complaint   RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  step        String
  reachedAt   DateTime          @default(now())
  note        String?

  @@index([complaintId])
}

model Referral {
  id            String              @id @default(cuid())
  code          String              @unique
  referrerName  String
  referrerEmail String
  createdAt     DateTime            @default(now())
  complaints    RecoveryComplaint[]
}

model LeadMagnetSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  companyName String?
  createdAt   DateTime @default(now())
}
