datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RecoveryComplaint {
  id                  String             @id @default(cuid())
  referenceId         String             @unique
  companyName         String
  rcNumber            String
  turnoverBand        String
  banks               String[]
  contactName         String
  contactTitle        String
  contactEmail        String
  contactPhone        String
  confirmedSignatory  Boolean
  agreedNDPA          Boolean
  status              String             @default("received")
  assignedTeam        String?
  referralCode        String?
  referral            Referral?          @relation(fields: [referralCode], references: [code])
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents           UploadedDocument[]
  statusEvents        CaseStatusEvent[]
  notes               CaseNote[]
  findingsSummary     String?
  recoveryAmountKobo  BigInt?
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
  @@index([closedAt])
  @@index([userId])
  @@index([contactEmail])
}

model UploadedDocument {
  id             String            @id @default(cuid())
  complaintId    String
  complaint      RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  documentType   String
  fileName       String
  storedAs       String
  fileSize       Int
  mimeType       String
  storageBackend String            @default("local")
  uploadedAt     DateTime          @default(now())
}

model CaseNote {
  id          String            @id @default(cuid())
  complaintId String
  complaint   RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String
  createdAt   DateTime          @default(now())

  @@index([complaintId, createdAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("admin")
  googleSub          String?   @unique
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  recoveryCodeHashes String[]
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?
  tokenInvalidBefore DateTime? @db.Timestamptz(3) // admin tokens issued before this are revoked
}

model User {
  id              String                @id @default(cuid())
  googleSub       String?               @unique
  email           String                @unique
  name            String?
  imageUrl        String?
  emailVerified   DateTime?
  createdAt       DateTime              @default(now())
  lastLoginAt     DateTime?
  complaints      RecoveryComplaint[]
  classifications SavedClassification[]
  roadmaps        SavedRoadmap[]
  sessions        Session[]
  emailChangeTokens EmailChangeToken[]
  positions       Position[]
  classificationBatches ClassificationBatch[]
  gicnProfile     GicnProfile?
  participants    Participant[]
  sponsorships    Sponsorship[]

  @@index([email])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
}

model SavedClassification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  input     Json
  results   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model SavedRoadmap {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String
  input                Json
  results              Json
  completedMilestones  Int[]
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model Webhook {
  id          String            @id @default(cuid())
  label       String
  url         String
  secret      String
  active      Boolean           @default(true)
  events      String[]
  filter      Json?
  createdAt   DateTime          @default(now())
  lastSentAt  DateTime?
  failCount   Int               @default(0)
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  signature     String
  status        String    @default("pending") // pending|success|failed|dead
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  responseCode  Int?
  responseBody  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

model CaseStatusEvent {
  id          String            @id @default(cuid())
  complaintId String
  complaint   RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  step        String
  reachedAt   DateTime          @default(now())
  note        String?

  @@index([complaintId])
}

model Referral {
  id                    String              @id @default(cuid())
  code                  String              @unique
  referrerName          String
  referrerEmail         String
  verifiedAt            DateTime?           @db.Timestamptz(3)
  verificationTokenHash String?             @unique
  bankDetails           String?
  paidOutKobo           BigInt              @default(0)
  lastPaidAt            DateTime?           @db.Timestamptz(3)
  createdAt             DateTime            @default(now())
  complaints            RecoveryComplaint[]

  @@index([referrerEmail])
}

model LeadMagnetSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  companyName String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorLabel String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([action])
  @@index([actorLabel])
}

// ─── Staff classification: hybrid position catalog + bulk jobs ──────────────

model Position {
  id               String   @id @default(cuid())
  userId           String?  // null = system/seed position; set = a user's custom position
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryCategory String
  departmentName   String
  description      String?
  isCustom         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([industryCategory])
}

model ClassificationBatch {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?
  status              String                @default("pending") // pending|processing|complete|failed
  total               Int                   @default(0)
  completed           Int                   @default(0)
  selectedPositionIds String[]
  classifications     StaffClassification[]
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status])
}

model StaffClassification {
  id              String              @id @default(cuid())
  batchId         String
  batch           ClassificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staffName       String
  staffRef        String?
  inputAttributes Json
  results         Json? // ranked positions + reasoning; null until processed
  status          String              @default("pending") // pending|complete|failed
  error           String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@index([batchId])
  @@index([status])
}

// First-party funnel/event capture (anonymous) — mirrors what @vercel/analytics
// receives so /admin/analytics can show conversion drop-off from our own DB.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([name, createdAt])
  @@index([createdAt])
}

// ─── GICN (Global Impact Christian Network — youth / NGO arm) ───────────────
// Minors NEVER hold accounts: every account is an adult (guardian or school
// partner) holding a GicnProfile. Children exist only as dependent Participant
// records owned by an adult User. Status/type columns are String + const unions
// (lib/gicn.ts), matching the platform convention.

model GicnProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind             String // guardian | school
  organizationName String? // school name (school partners)
  phone            String?
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
}

model Participant {
  id                    String                @id @default(cuid())
  ownerUserId           String
  owner                 User                  @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  fullName              String
  dateOfBirth           DateTime              @db.Timestamptz(3)
  schoolName            String?
  classLevel            String?
  address               String?
  guardianName          String
  consentGrantedAt      DateTime              @db.Timestamptz(3)
  consentGrantedByUserId String // the adult who granted consent (owner, or school user for bulk)
  mediaReleaseGranted   Boolean               @default(false)
  createdAt             DateTime              @default(now()) @db.Timestamptz(3)
  registrations         ProgramRegistration[]
  sponsorships          Sponsorship[]
  awards                ScholarshipAward[]

  @@index([ownerUserId])
}

model Program {
  id            String                @id @default(cuid())
  title         String
  type          String // SCHOLARSHIP | LEADERSHIP_CONFERENCE | CHRISTIAN_CAMP | INTELLECTUAL_COMPETITION | TALENT_SHOW | ACADEMIC_COMPETITION | OTHER
  description   String?
  startsAt      DateTime              @db.Timestamptz(3)
  endsAt        DateTime              @db.Timestamptz(3)
  capacity      Int?
  location      String?
  status        String                @default("DRAFT") // DRAFT | OPEN | CLOSED | COMPLETED
  requiresApproval Boolean            @default(false) // when true, registrations start as SUBMITTED and need admin approval
  createdAt     DateTime              @default(now()) @db.Timestamptz(3)
  registrations ProgramRegistration[]
  sponsorships  Sponsorship[]
  awards        ScholarshipAward[]

  @@index([status])
  @@index([startsAt])
}

model ProgramRegistration {
  id            String      @id @default(cuid())
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  programId     String
  program       Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  status        String      @default("SUBMITTED") // SUBMITTED | UNDER_REVIEW | APPROVED | REJECTED | WAITLISTED | CANCELLED
  checkInCode   String      @unique
  checkedInAt   DateTime?   @db.Timestamptz(3)
  reviewedAt    DateTime?   @db.Timestamptz(3) // when an admin last actioned (approve/reject/waitlist/claim)
  reviewedBy    String? // admin email that actioned
  reviewNote    String? // rejection reason / review note
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)

  @@unique([participantId, programId])
  @@index([programId, status])
}

model Sponsorship {
  id            String       @id @default(cuid())
  sponsorUserId String?
  sponsorUser   User?        @relation(fields: [sponsorUserId], references: [id], onDelete: SetNull)
  sponsorName   String
  sponsorEmail  String
  amountKobo    BigInt
  programId     String?
  program       Program?     @relation(fields: [programId], references: [id], onDelete: SetNull)
  participantId String?
  participant   Participant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  status         String       @default("pending") // pending | paid | failed
  idempotencyKey String?      @unique // client-supplied; dedupes double-submits / retries
  reference      String?      @unique // our Paystack transaction reference (set at checkout init)
  providerRef    String?      // Paystack access_code / transaction id — for reconciliation
  authorizationUrl String?    // Paystack hosted-checkout URL — reused on retry (no re-charge)
  paidAt         DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  @@index([programId])
  @@index([participantId])
  @@index([createdAt])
}

model ScholarshipAward {
  id              String      @id @default(cuid())
  reference       String?     @unique // SCH-XXXXXX (human-facing)
  participantId   String
  participant     Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  programId       String
  program         Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  // applied | under_review | awarded | rejected | onboarding | active | suspended | completed | terminated | withdrawn
  status          String      @default("applied")
  awardAmountKobo BigInt
  term            String?
  academicYear    String?
  conditionsSummary String?
  appliedByUserId String? // guardian who applied (if guardian-initiated)

  // Encrypted-at-rest, NDPA — never returned in plaintext by any list/detail API.
  ninEncrypted           String? // AES-256-GCM (lib/totp encryptSecret); collected at onboarding/payout
  payoutBankName         String?
  payoutAccountLast4     String?
  payoutAccountEncrypted String? // full account number, AES-256-GCM; reveal-gated (step-up)

  // Review/lifecycle bookkeeping
  reviewedBy            String?
  reviewedAt            DateTime? @db.Timestamptz(3)
  reviewNote            String?
  awardedBy            String?
  awardedAt            DateTime? @db.Timestamptz(3)
  onboardingSubmittedAt DateTime? @db.Timestamptz(3)
  activatedAt          DateTime? @db.Timestamptz(3)
  suspendedReason      String?
  renewalDueAt         DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(3)

  reviews         ScholarshipReview[]
  conditions      ScholarshipCondition[]
  academicRecords ScholarshipAcademicRecord[]
  disbursements   ScholarshipDisbursement[]
  documents       ScholarshipDocument[]

  @@index([participantId])
  @@index([programId])
  @@index([status])
}

model ScholarshipReview {
  id            String           @id @default(cuid())
  awardId       String
  award         ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  reviewerEmail String // admin email, or "guardian"/"system"
  action        String // apply | nominate | claim | award | reject | request_changes | onboarding_submit | verify_activate | suspend | reinstate | complete | terminate | withdraw | renew
  note          String?
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  @@index([awardId])
}

model ScholarshipCondition {
  id        String           @id @default(cuid())
  awardId   String
  award     ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  label     String
  met       Boolean          @default(false)
  metAt     DateTime?        @db.Timestamptz(3)
  metBy     String?
  note      String?
  createdAt DateTime         @default(now()) @db.Timestamptz(3)

  @@index([awardId])
}

model ScholarshipAcademicRecord {
  id           String           @id @default(cuid())
  awardId      String
  award        ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  term         String
  academicYear String?
  school       String?
  classLevel   String?
  gradeOrGpa   String?
  attendancePct Int?
  standing     String           @default("on_track") // on_track | at_risk | breach
  note         String?
  recordedBy   String?
  createdAt    DateTime         @default(now()) @db.Timestamptz(3)

  @@index([awardId])
}

model ScholarshipDisbursement {
  id         String           @id @default(cuid())
  awardId    String
  award      ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  label      String
  amountKobo BigInt
  method     String           @default("bank") // bank | cash | paystack
  reference  String?
  status     String           @default("scheduled") // scheduled | paid | failed | cancelled
  paidAt     DateTime?        @db.Timestamptz(3)
  recordedBy String?
  note       String?
  createdAt  DateTime         @default(now()) @db.Timestamptz(3)

  @@index([awardId])
}

model ScholarshipDocument {
  id              String           @id @default(cuid())
  awardId         String
  award           ScholarshipAward @relation(fields: [awardId], references: [id], onDelete: Cascade)
  documentType    String // admission_letter | results | id_card | birth_certificate | other
  fileName        String
  storedAs        String
  fileSize        Int
  mimeType        String
  storageBackend  String           @default("local")
  uploadedByUserId String?
  uploadedByLabel String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)

  @@index([awardId])
}
