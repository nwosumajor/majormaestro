datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model RecoveryComplaint {
  id                  String             @id @default(cuid())
  referenceId         String             @unique
  companyName         String
  rcNumber            String
  turnoverBand        String
  banks               String[]
  contactName         String
  contactTitle        String
  contactEmail        String
  contactPhone        String
  confirmedSignatory  Boolean
  agreedNDPA          Boolean
  status              String             @default("received")
  assignedTeam        String?
  referralCode        String?
  referral            Referral?          @relation(fields: [referralCode], references: [code])
  userId              String?
  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  documents           UploadedDocument[]
  statusEvents        CaseStatusEvent[]
  notes               CaseNote[]
  findingsSummary     String?
  recoveryAmountKobo  BigInt?
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
  @@index([closedAt])
  @@index([userId])
  @@index([contactEmail])
}

model UploadedDocument {
  id             String            @id @default(cuid())
  complaintId    String
  complaint      RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  documentType   String
  fileName       String
  storedAs       String
  fileSize       Int
  mimeType       String
  storageBackend String            @default("local")
  uploadedAt     DateTime          @default(now())
}

model CaseNote {
  id          String            @id @default(cuid())
  complaintId String
  complaint   RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String
  createdAt   DateTime          @default(now())

  @@index([complaintId, createdAt])
}

model AdminUser {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               String    @default("admin")
  googleSub          String?   @unique
  totpSecret         String?
  totpEnabled        Boolean   @default(false)
  recoveryCodeHashes String[]
  createdAt          DateTime  @default(now())
  lastLoginAt        DateTime?
  tokenInvalidBefore DateTime? @db.Timestamptz(3) // admin tokens issued before this are revoked
}

model User {
  id              String                @id @default(cuid())
  googleSub       String?               @unique
  email           String                @unique
  name            String?
  imageUrl        String?
  emailVerified   DateTime?
  createdAt       DateTime              @default(now())
  lastLoginAt     DateTime?
  complaints      RecoveryComplaint[]
  classifications SavedClassification[]
  roadmaps        SavedRoadmap[]
  sessions        Session[]
  emailChangeTokens EmailChangeToken[]
  positions       Position[]
  classificationBatches ClassificationBatch[]

  @@index([email])
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent  String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
}

model EmailChangeToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model MagicLinkToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([email, createdAt])
  @@index([expiresAt])
}

model SavedClassification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  input     Json
  results   Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model SavedRoadmap {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                String
  input                Json
  results              Json
  completedMilestones  Int[]
  createdAt            DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
}

model Webhook {
  id          String            @id @default(cuid())
  label       String
  url         String
  secret      String
  active      Boolean           @default(true)
  events      String[]
  filter      Json?
  createdAt   DateTime          @default(now())
  lastSentAt  DateTime?
  failCount   Int               @default(0)
  deliveries  WebhookDelivery[]
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event         String
  payload       Json
  signature     String
  status        String    @default("pending") // pending|success|failed|dead
  attempts      Int       @default(0)
  lastAttemptAt DateTime? @db.Timestamptz(3)
  nextAttemptAt DateTime? @db.Timestamptz(3)
  responseCode  Int?
  responseBody  String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  @@index([webhookId, createdAt])
  @@index([status, nextAttemptAt])
}

model CaseStatusEvent {
  id          String            @id @default(cuid())
  complaintId String
  complaint   RecoveryComplaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  step        String
  reachedAt   DateTime          @default(now())
  note        String?

  @@index([complaintId])
}

model Referral {
  id                    String              @id @default(cuid())
  code                  String              @unique
  referrerName          String
  referrerEmail         String
  verifiedAt            DateTime?           @db.Timestamptz(3)
  verificationTokenHash String?             @unique
  bankDetails           String?
  paidOutKobo           BigInt              @default(0)
  lastPaidAt            DateTime?           @db.Timestamptz(3)
  createdAt             DateTime            @default(now())
  complaints            RecoveryComplaint[]

  @@index([referrerEmail])
}

model LeadMagnetSubscriber {
  id          String   @id @default(cuid())
  email       String   @unique
  companyName String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  actorLabel String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
  @@index([action])
  @@index([actorLabel])
}

// ─── Staff classification: hybrid position catalog + bulk jobs ──────────────

model Position {
  id               String   @id @default(cuid())
  userId           String?  // null = system/seed position; set = a user's custom position
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  industryCategory String
  departmentName   String
  description      String?
  isCustom         Boolean  @default(false)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([industryCategory])
}

model ClassificationBatch {
  id                  String                @id @default(cuid())
  userId              String
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  label               String?
  status              String                @default("pending") // pending|processing|complete|failed
  total               Int                   @default(0)
  completed           Int                   @default(0)
  selectedPositionIds String[]
  classifications     StaffClassification[]
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([status])
}

model StaffClassification {
  id              String              @id @default(cuid())
  batchId         String
  batch           ClassificationBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  staffName       String
  staffRef        String?
  inputAttributes Json
  results         Json? // ranked positions + reasoning; null until processed
  status          String              @default("pending") // pending|complete|failed
  error           String?
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)

  @@index([batchId])
  @@index([status])
}

// First-party funnel/event capture (anonymous) — mirrors what @vercel/analytics
// receives so /admin/analytics can show conversion drop-off from our own DB.
model AnalyticsEvent {
  id        String   @id @default(cuid())
  name      String
  props     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([name, createdAt])
  @@index([createdAt])
}
