# ─── AI ────────────────────────────────────────────────────────────────────
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ─── Database ────────────────────────────────────────────────────────────
# PostgreSQL connection string (Supabase, Neon, or self-hosted)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Supabase: https://supabase.com → Project Settings → Database → Connection string
# Neon:     https://neon.tech → Connection Details → Connection String
DATABASE_URL=postgresql://postgres:password@localhost:5432/ms2app?schema=public

# ─── Email (Resend) ──────────────────────────────────────────────────────
# Get your key at: https://resend.com/api-keys
# You must verify your sending domain in Resend before emails will deliver.
# For testing, Resend allows sending to your own verified email with any FROM.
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL="MajorGBN <noreply@yourdomain.com>"
INTERNAL_NOTIFY_EMAIL=ops@yourdomain.com

# ─── App URL ─────────────────────────────────────────────────────────────
# Used in email templates, sitemap, and robots.txt to generate correct links
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ─── Admin Panel ─────────────────────────────────────────────────────────
# Bootstrap password used to create the first admin user on first login.
# Once any AdminUser row exists, this is ignored — create additional admins via
# /admin/users instead. Rotate this anyway as defence in depth.
ADMIN_PASSWORD=change-me-to-a-long-random-string
# HMAC secret for signing the admin session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters. Rotating invalidates all existing sessions.
ADMIN_SESSION_SECRET=change-me-to-a-64-character-random-hex-string

# ─── Document Storage ────────────────────────────────────────────────────
# Choose "local" (default, writes to ./uploads) or "s3" (any S3-compatible
# backend — AWS S3, Cloudflare R2, MinIO, Backblaze B2, etc.).
# Existing UploadedDocument rows record their backend per-row, so you can flip
# this for new uploads without breaking old downloads.
STORAGE_BACKEND=local
# Required when STORAGE_BACKEND=s3:
S3_BUCKET=your-bucket-name
S3_REGION=eu-west-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret
# Optional — set for R2, MinIO, or any non-AWS endpoint. Leave blank for AWS S3.
# S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# ─── Recovery Onboarding ─────────────────────────────────────────────────
# Letter-of-Authorization signatory enforcement. "advisory" (default) captures
# the chosen method + signatories and warns (audit-logged) on non-conformance
# but still accepts the submission; "strict" rejects non-conforming submissions
# (422). Tighten to strict once the firm is ready.
# LOA_SIGNATORY_ENFORCEMENT=advisory

# Contact-verification OTP. When "true", an intake cannot be finalized until the
# email is verified by code (and the phone too, but ONLY if an SMS provider is
# configured below — otherwise phone verification is skipped gracefully).
# Defaults off; email OTP is always offered optionally in the form.
# RECOVERY_OTP_REQUIRED=false

# SMS provider (optional) for phone OTP. With both unset, SMS verification is a
# logged no-op (stub) and phone OTP is hidden in the form / not enforced.
# SMS_PROVIDER=termii
# SMS_API_KEY=
# SMS_SENDER_ID=MajorGBN

# ─── Rate Limiting (durable, cross-instance) ─────────────────────────────
# Optional. When set, rate limits are enforced via Upstash Redis (REST), shared
# across all serverless instances and surviving deploys. When unset, the limiter
# falls back to a per-instance in-memory window (fine for dev / single instance).
# Vercel KV's REST aliases (KV_REST_API_URL / KV_REST_API_TOKEN) are also read.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-rest-token

# ─── Retention Policy ────────────────────────────────────────────────────
# Days to keep closed-case documents before they become eligible for purge.
# Defaults to 1095 (3 years) which mirrors common Nigerian banking record-keeping
# practice. Reduce only after consulting compliance.
# RETENTION_DAYS=1095
# Days to keep audit-log entries before they become eligible for purge.
# Defaults to 730 (2 years).
# AUDIT_LOG_RETENTION_DAYS=730

# ─── Webhook Retry Cron ──────────────────────────────────────────────────
# Shared secret required by /api/cron/webhooks/retry. Either pass it as
#   Authorization: Bearer <value>      OR
#   X-Cron-Secret: <value>
# Recommended invocation: every 5 minutes via Vercel Cron, GitHub Actions,
# or any external scheduler.
CRON_SECRET=change-me-to-a-long-random-string

# ─── Payments (Paystack — GICN sponsorships) ────────────────────────────
# NGN/kobo-native gateway. Get keys at https://dashboard.paystack.com/#/settings/developers
# Use sk_test_… while testing, sk_live_… in production. Server-only — never expose.
# Set the dashboard webhook URL to: <NEXT_PUBLIC_APP_URL>/api/gicn/sponsor/webhook
# When unset, the sponsorship pledge flow falls back to a no-op "pending" stub.
PAYSTACK_SECRET_KEY=
# PAYSTACK_PUBLIC_KEY=   # only needed for inline checkout; the redirect flow doesn't use it

# ─── Google OAuth (client + admin sign-in) ──────────────────────────────
# Create an OAuth 2.0 Client ID in Google Cloud Console (type: Web application).
# Authorised redirect URI must be: <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict admin Google sign-in to a single Workspace domain.
# Leave blank to allow admins to use any Google account that matches a
# pre-existing AdminUser row.
# ADMIN_GOOGLE_DOMAIN=majormaestro.com

# ─── Sentry (error tracking — optional) ─────────────────────────────────
# All Sentry config is a no-op until these are set, so the app runs fine
# without them. Create a Next.js project at https://sentry.io to get a DSN.
# Runtime capture (server + edge runtimes read SENTRY_DSN):
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Browser capture — MUST be set at BUILD time (NEXT_PUBLIC_* is inlined into
# the bundle), so set it in Vercel and redeploy. Usually the same DSN value.
# NEXT_PUBLIC_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Build-time source-map upload (optional but recommended). Without
# SENTRY_AUTH_TOKEN, withSentryConfig in next.config.ts is a pass-through
# no-op (errors still captured, but stack traces won't be un-minified).
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_...
# Set SENTRY_ENABLE_DEV=1 to capture exceptions in local dev (off by default).
# SENTRY_ENABLE_DEV=1

# ── Webhook receiver (app/api/webhooks/inbound) ────────────────────────────
# Secret used to VERIFY inbound webhook signatures. Must exactly match the
# secret of the webhook you create in /admin/webhooks that targets
# https://<host>/api/webhooks/inbound. Without this, the receiver fails closed
# (503) and rejects every delivery. Generate with the admin panel's webhook
# create flow, or: openssl rand -hex 24  (then prefix to taste).
# GBN_WEBHOOK_RECEIVER_SECRET=whsec_...
# Optional: relay verified events to a Slack Incoming Webhook. Leave unset to
# just verify + log (no third-party data sharing). The referrer email is never
# forwarded (NDPA data minimisation).
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
